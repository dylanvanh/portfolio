---
import TechList from "./TechList.astro";

const { description, technologies } = Astro.props as {
  description?: string;
  technologies?: string[];
};
---

<article>
  <div
    class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
  >
    <h3 class="text-primary min-w-0 leading-6 text-pretty">
      <slot name="title" />
    </h3>
    <div
      class="text-secondary flex shrink-0 items-baseline gap-3 text-sm tabular-nums"
    >
      <slot name="meta" />
    </div>
  </div>
  {
    description && (
      <p class="text-secondary mt-2 text-sm leading-6 text-pretty">
        {description}
      </p>
    )
  }
  {
    technologies && technologies.length > 0 && (
      <TechList technologies={technologies} />
    )
  }
</article>
