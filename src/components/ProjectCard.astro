---
import type { ProjectItem } from "../types/ProjectItem";
import Entry from "./Entry.astro";

const { title, technologies, href, websiteUrl, primaryLinkAriaLabel } =
  Astro.props as ProjectItem;
const isGitHubLink = href.startsWith("https://github.com/");
const linkClass = "hover:text-primary transition-colors duration-150";
---

<Entry technologies={technologies}>
  <span slot="title" class="font-medium">{title}</span>
  <Fragment slot="meta">
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class={linkClass}
      aria-label={primaryLinkAriaLabel ??
        `${title} ${isGitHubLink ? "GitHub repository" : "website"}`}
    >
      {isGitHubLink ? "GitHub" : "Website"} ↗
    </a>
    {
      websiteUrl && (
        <a
          href={websiteUrl}
          target="_blank"
          rel="noopener noreferrer"
          class={linkClass}
          aria-label={`${title} live website`}
        >
          Live ↗
        </a>
      )
    }
  </Fragment>
</Entry>
