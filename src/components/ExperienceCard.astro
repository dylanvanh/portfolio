---
import type { ExperienceItem } from "../types/ExperienceItem";
import Entry from "./Entry.astro";

const { period, company, position, description, technologies } =
  Astro.props as ExperienceItem;
---

<Entry description={description} technologies={technologies}>
  <Fragment slot="title">
    <span class="font-medium">{company}</span>
    <span class="text-secondary"> · {position}</span>
  </Fragment>
  <span slot="meta">{period}</span>
</Entry>
