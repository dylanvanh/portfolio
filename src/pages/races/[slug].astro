---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CourseMap from "../../components/CourseMap.astro";
import {
  KIND_LABEL,
  SPORT_LABEL,
  byNewest,
  formatDate,
  formatDistance,
  formatPace,
  formatTime,
  raceDistance,
  raceElevation,
  racePhotos,
  type Race,
} from "../../lib/races";

export async function getStaticPaths() {
  const races = (await getCollection("races")).sort(byNewest);
  return races.map((race, index) => ({
    params: { slug: race.id },
    props: { race, newer: races[index - 1], older: races[index + 1] },
  }));
}

interface Props {
  race: Race;
  newer?: Race;
  older?: Race;
}

const { race, newer, older } = Astro.props;
const { data } = race;
const { cover, gallery } = racePhotos(race.id);
const elevation = raceElevation(race);
const isMulti = data.legs.length > 1;
const courses = data.legs.filter((leg) => leg.polyline);
const activities = data.legs.filter((leg) => leg.strava);

const stats = [
  {
    label: data.official ? "Official time" : "Finish time",
    value: formatTime(data.time),
  },
  { label: "Distance", value: formatDistance(raceDistance(race)) },
  elevation > 0
    ? {
        label: "Elevation gain",
        value: `${Math.round(elevation).toLocaleString("en-US")} m`,
      }
    : { label: "Type", value: KIND_LABEL[data.kind] },
];

// Swim, T1, bike, T2, run as proportional segments.
const segments = isMulti
  ? data.legs.flatMap((leg, index) => {
      const part = [
        { label: SPORT_LABEL[leg.sport], time: leg.time, leg: true },
      ];
      const transition = data.transitions?.[index];
      if (transition) {
        part.push({ label: `T${index + 1}`, time: transition, leg: false });
      }
      return part;
    })
  : [];
const segmentTotal = segments.reduce((sum, s) => sum + s.time, 0);
const LEG_TONES = ["bg-accent/45", "bg-accent", "bg-accent/70"];
---

<Layout
  title={`${data.name} ${data.date.getUTCFullYear()}`}
  description={`${data.name}, ${formatDate(data.date)} in ${data.city}: finished in ${formatTime(data.time)}.`}
>
  <main class="mx-auto max-w-[760px] px-6 py-8 sm:px-8 sm:py-12">
    <a
      href="/races"
      data-astro-prefetch
      class="text-secondary hover:text-primary mb-16 inline-flex items-center gap-2 text-sm transition-colors duration-150"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m15 18-6-6 6-6"></path>
      </svg>
      Races
    </a>

    <header>
      <p class="text-accent mb-4 text-sm">
        <time datetime={data.date.toISOString().slice(0, 10)}
          >{formatDate(data.date)}</time
        > · {data.city}, {data.country}
      </p>
      <h1 class="text-primary text-4xl font-semibold text-balance sm:text-5xl">
        {data.name}
      </h1>
      <p class="text-secondary mt-4 text-lg">
        {KIND_LABEL[data.kind]} · {data.distanceLabel}
      </p>
    </header>

    {
      cover && (
        <Image
          src={cover.image}
          alt={`${data.name} ${data.date.getUTCFullYear()}`}
          widths={[640, 1040, 1520]}
          sizes="(min-width: 760px) 696px, 100vw"
          class="border-border mt-10 aspect-[3/2] w-full rounded-lg border object-cover"
          loading="eager"
        />
      )
    }

    <dl class="mt-10 grid grid-cols-3 gap-3">
      {
        stats.map((stat) => (
          <div class="border-border bg-surface rounded-lg border p-4 sm:p-5">
            <dt class="text-secondary text-xs sm:text-sm">{stat.label}</dt>
            <dd class="text-primary mt-2 text-xl font-semibold tabular-nums sm:text-2xl">
              {stat.value}
            </dd>
          </div>
        ))
      }
    </dl>

    <section class="border-border mt-12 border-t pt-12">
      <div
        class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2"
      >
        <h2 class="text-primary text-sm font-medium">Splits</h2>
        {
          activities.length > 0 && (
            <p class="text-secondary flex items-baseline gap-3 text-sm">
              {isMulti && <span>Strava</span>}
              {activities.map((leg) => (
                <a
                  href={`https://www.strava.com/activities/${leg.strava}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-accent underline decoration-white/20 underline-offset-4 transition-colors duration-150"
                >
                  {isMulti ? SPORT_LABEL[leg.sport] : "View on Strava"}
                  <span aria-hidden="true"> ↗</span>
                </a>
              ))}
            </p>
          )
        }
      </div>
      {
        isMulti && (
          <div
            class="mt-5 flex h-2 gap-0.5 overflow-hidden rounded-full"
            aria-hidden="true"
          >
            {segments.map((segment, index) => (
              <div
                class={segment.leg ? LEG_TONES[index / 2] : "bg-border"}
                style={`width: ${(segment.time / segmentTotal) * 100}%`}
              />
            ))}
          </div>
        )
      }
      <table class="mt-5 w-full text-sm tabular-nums">
        <thead class="sr-only">
          <tr
            ><th>Leg</th><th>Distance</th><th>Pace</th><th>Elevation gain</th
            ><th>Time</th></tr
          >
        </thead>
        <tbody class="divide-border divide-y">
          {
            data.legs.map((leg, index) => (
              <>
                <tr>
                  <th
                    scope="row"
                    class="text-primary py-3 text-left font-medium"
                  >
                    {SPORT_LABEL[leg.sport]}
                  </th>
                  <td class="text-secondary py-3">
                    {formatDistance(leg.distance)}
                  </td>
                  <td class="text-secondary py-3">{formatPace(leg)}</td>
                  <td class="text-secondary py-3">
                    {leg.sport !== "swim" && leg.elevation > 0 && (
                      <>
                        <span aria-hidden="true">↑ </span>
                        {Math.round(leg.elevation).toLocaleString("en-US")} m
                      </>
                    )}
                  </td>
                  <td class="text-primary py-3 text-right">
                    {formatTime(leg.time)}
                  </td>
                </tr>
                {data.transitions?.[index] && (
                  <tr>
                    <th
                      scope="row"
                      class="text-secondary py-3 text-left font-normal"
                    >
                      Transition {index + 1}
                    </th>
                    <td />
                    <td />
                    <td />
                    <td class="text-secondary py-3 text-right">
                      {formatTime(data.transitions[index])}
                    </td>
                  </tr>
                )}
              </>
            ))
          }
        </tbody>
      </table>
    </section>

    {
      courses.length > 0 && (
        <section class="border-border mt-12 border-t pt-12">
          <h2 class="text-primary text-sm font-medium">Course</h2>
          <div
            class:list={[
              "mt-5 grid gap-3",
              courses.length > 1 && "sm:grid-cols-3",
            ]}
          >
            {courses.map((leg) => (
              <figure class="border-border bg-surface overflow-hidden rounded-lg border">
                <CourseMap
                  polyline={leg.polyline!}
                  label={`${SPORT_LABEL[leg.sport]} course, ${formatDistance(leg.distance)}`}
                />
                {courses.length > 1 && (
                  <figcaption class="border-border text-secondary flex justify-between border-t px-4 py-2.5 text-xs tabular-nums">
                    <span class="text-primary">{SPORT_LABEL[leg.sport]}</span>
                    {formatDistance(leg.distance)}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      data.note && (
        <section class="border-border mt-12 border-t pt-12">
          <h2 class="text-primary text-sm font-medium">Notes</h2>
          <p class="text-secondary mt-5 max-w-xl text-lg leading-8 text-pretty">
            {data.note}
          </p>
        </section>
      )
    }

    {
      gallery.length > 0 && (
        <section class="border-border mt-12 border-t pt-12">
          <h2 class="text-primary text-sm font-medium">Photos</h2>
          <div class="mt-5 columns-2 gap-3 sm:columns-3">
            {gallery.map((photo) => (
              <Image
                src={photo.image}
                alt={`${data.name} ${data.date.getUTCFullYear()}`}
                widths={[320, 520, 760]}
                sizes="(min-width: 640px) 224px, 50vw"
                class="border-border mb-3 w-full rounded-lg border"
              />
            ))}
          </div>
        </section>
      )
    }

    <nav
      class="border-border mt-12 flex justify-between gap-6 border-t py-8 text-sm"
      aria-label="Other races"
    >
      {
        older ? (
          <a
            href={`/races/${older.id}`}
            data-astro-prefetch
            class="text-secondary hover:text-primary transition-colors duration-150"
          >
            ← {older.data.name} {older.data.date.getUTCFullYear()}
          </a>
        ) : (
          <span />
        )
      }
      {
        newer && (
          <a
            href={`/races/${newer.id}`}
            data-astro-prefetch
            class="text-secondary hover:text-primary text-right transition-colors duration-150"
          >
            {newer.data.name} {newer.data.date.getUTCFullYear()} →
          </a>
        )
      }
    </nav>
  </main>
</Layout>
